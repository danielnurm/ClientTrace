# Copy to .env and fill in. Never commit .env.

# Required: scraping current customer pages
CONTEXT_DEV_API_KEY=

# Optional: how many Context.dev requests may run at once (default 2).
# Raise it if your plan allows more.
CONTEXT_DEV_CONCURRENCY=

# Optional: AI name matching (rule-based matching is used without it)
OPENAI_API_KEY=

# Optional: competitor search
EXA_API_KEY=
